{
  "name": "omnichannel-tech-validation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "start": "tsx src/server.ts",
    "prepare:vision": "tsx scripts/prepare-vision.ts",
    "test:live": "tsx scripts/live-e2e.ts",
    "test:startup": "tsx scripts/live-startup-e2e.ts",
    "test:realtime": "tsx scripts/realtime-validation.ts",
    "test:guards": "tsx scripts/guard-validation.ts",
    "benchmark:baseline": "tsx scripts/accuracy-benchmark.ts baseline",
    "benchmark:accuracy": "tsx scripts/accuracy-benchmark.ts improved",
    "benchmark:processor": "tsx scripts/processor-probe.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src scripts tests",
    "validate": "tsx scripts/validate.ts",
    "e2e": "tsx scripts/e2e.ts",
    "report": "tsx scripts/report.ts && tsx scripts/report-live.ts && tsx scripts/report-realtime.ts",
    "probe": "tsx scripts/probe.ts",
    "ui:smoke": "tsx scripts/ui-smoke.ts",
    "audit:record": "tsx scripts/audit.ts",
    "test:record": "vitest run --reporter=json --outputFile=artifacts/unit-results.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "linkedom": "^0.18.12",
    "robots-parser": "^3.0.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/chrome": "^0.1.32",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "playwright": "^1.57.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^5.0.2"
  }
}
